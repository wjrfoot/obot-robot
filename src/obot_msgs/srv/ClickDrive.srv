# Commands: PREPARE, TURN, DRIVE, STOP, STATUS, MANUAL_BEGIN, MANUAL, MANUAL_END
string command

# TURN: positive = right, negative = left (degrees)
float64 angle_deg

# DRIVE: positive forward distance (meters)
float64 distance_m

# TURN/DRIVE and MANUAL speed limits, frozen for each requested motion.
float64 linear_speed_mps
float64 angular_speed_rps

# Viewer instance and monotonically increasing request sequence.
string client_id
uint64 sequence

# PREPARE requests a one-use permit for this movement command.
string permit_command
# Movement requests carry the permit returned by PREPARE.
string permit_id

# MANUAL: -1, 0, or 1 for the requested linear and angular directions.
int8 linear_direction
int8 angular_direction
---
bool accepted
string state
string message
string permit_id
