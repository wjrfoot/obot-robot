[Unit]
Description=OBot ClickDrive Motion Controller
After=network-online.target obot.service
Wants=network-online.target
Requires=obot.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/obot_ws
Environment=PYTHONUNBUFFERED=1
Environment=ROS_DOMAIN_ID=5
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=CYCLONEDDS_URI=file:///home/pi/cyclonedds_obot.xml
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/pi/obot_ws/install/setup.bash && exec ros2 run obot obot_cmd_motion --ros-args -p cmd_topic:=/cmd_vel_nav'
Restart=on-failure
RestartSec=3
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
